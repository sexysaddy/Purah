# Legacy fallback only: ignored whenever ~/.config/purah/config.toml exists.
# Fallback environment only. Any setting explicitly present in ~/.config/purah/config.toml wins over these values.
# Copy to ~/.config/purah/env, set your own key, then: chmod 600 ~/.config/purah/env
OPENAI_API_KEY=PUT_YOUR_API_KEY_HERE
PURAH_API_URL=https://api.groq.com/openai/v1/chat/completions
PURAH_MODEL=openai/gpt-oss-120b
PURAH_STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
PURAH_STT_MODEL=whisper-large-v3-turbo
PURAH_STT_LANGUAGE=ru
PURAH_STT_TIMEOUT=28
PURAH_VAD_THRESHOLD=180
PURAH_END_SILENCE_SECONDS=0.65
PURAH_MAX_RECORD_SECONDS=20
PURAH_SPEECH_START_TIMEOUT=7
PURAH_API_TIMEOUT=50
PURAH_TYPEWRITER_INTERVAL_MS=20

# Uncomment and set if the default input device is wrong:
# PURAH_INPUT_DEVICE=2

# Optional separate provider for vision:
# PURAH_VISION_URL=https://api.groq.com/openai/v1/chat/completions
# PURAH_VISION_MODEL=qwen/qwen3.8-27b

# Optional Kokoro tuning (config.toml is easier). Config values always win:
# PURAH_KOKORO_VOICE=masha
# PURAH_KOKORO_SPEED=1.10
# PURAH_KOKORO_THREADS=4

# Never use environment variables to override model/provider settings already present in config.toml.

# Optional background Telegram user-session connector (configure via setup_telegram.py).
# PURAH_TELEGRAM_API_ID=
# PURAH_TELEGRAM_API_HASH=
# PURAH_TELEGRAM_SESSION=~/.config/purah/telegram.session
